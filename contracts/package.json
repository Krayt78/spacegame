{
  "name": "nexus-protocol-contracts",
  "version": "1.0.0",
  "description": "Smart contracts for Nexus Protocol - on-chain space strategy game",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost && node scripts/exportABI.js",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network polkadotHubTestnet",
    "upgrade:local": "hardhat run scripts/upgrade.ts --network localhost",
    "upgrade:testnet": "hardhat run scripts/upgrade.ts --network polkadotHubTestnet",
    "upgrade:dry-run": "DRY_RUN=true hardhat run scripts/upgrade.ts --network polkadotHubTestnet",
    "export-abi": "node scripts/exportABI.js",
    "node": "hardhat node",
    "seed:local": "hardhat run scripts/seed-local.ts --network localhost",
    "fast-forward": "hardhat run scripts/fast-forward.ts --network localhost",
    "setup:galaxy": "hardhat run scripts/setupGalaxyTest.ts --network localhost",
    "verify:testnet": "hardhat run scripts/verify.ts --network polkadotHubTestnet"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krayt78/game_project_contracts.git"
  },
  "keywords": [
    "blockchain",
    "game",
    "polkadot",
    "solidity"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Krayt78/game_project_contracts/issues"
  },
  "homepage": "https://github.com/Krayt78/game_project_contracts#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "hardhat": "^2.22.0",
    "solc": "0.8.24"
  },
  "dependencies": {
    "dotenv": "^16.4.0"
  }
}

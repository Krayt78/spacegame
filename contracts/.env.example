# =============================================================================
# Nexus Protocol - Smart Contracts Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Deployer Wallet
# -----------------------------------------------------------------------------
# Private key for the account that will deploy contracts to testnet/mainnet.
# NEVER commit your real private key. Use a dedicated deployer wallet.
# Must be prefixed with 0x.
PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Network RPC URLs
# -----------------------------------------------------------------------------
# AssetHub Westend testnet (Polkadot EVM-compatible parachain)
# Default public endpoint: https://westend-asset-hub-eth-rpc.polkadot.io
ASSETHUB_RPC_URL=https://westend-asset-hub-eth-rpc.polkadot.io

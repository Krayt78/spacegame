# Local dev server (next dev), but pointed at the REAL paseo-next-v2 Asset Hub —
# not a local node. Use this to run a SECOND player on your machine: the
# DevProvider signs as Alice/Bob/… (a per-tab pick), so you can play a match
# against your dot.li product account, which lives on the same chain.
#
#   npm run dev:net      # → http://localhost:3000, DevProvider
#
# Alice (//Alice) must be funded + revive-mapped on the paseo-next-v2 Asset Hub
# for writes to land. Other dev accounts (Bob, …) need faucet funding first.

NEXT_PUBLIC_CHAIN=testnet

# Deployer mnemonic (sr25519). This file is TRACKED — leave it empty here and
# never commit a real phrase. Empty = the contract deploy falls back to //Alice.
MNEMONIC=

# DevProvider — sign locally as Alice/Bob/…, no Polkadot Host involved. Skips
# the "Open in Polkadot Host" gate.
NEXT_PUBLIC_SIGNER_PROVIDER=dev

# Reads (ReviveApi.call) AND writes (Revive.call) target the paseo-next-v2
# Asset Hub — the chain the contracts + your dot.li product account live on.
NEXT_PUBLIC_HUB_WS_URL=wss://paseo-asset-hub-next-rpc.polkadot.io

# Contract addresses — from contracts/deployments/next-v2.json (2026-07-15 deploy).
NEXT_PUBLIC_NEXUS_GAME_ADDRESS=0x915f137610346fda7db236373687ef8b43255980
NEXT_PUBLIC_GAME_CONFIG_ADDRESS=0x7b026c8c640e3c47d24af34484edc2036d056f55

# Force host-mode transport (PAPI reads + DevProvider signing). Without this a
# plain browser tab detects 'evm' (mode.ts: not inside a host container) and
# mounts the wagmi/ConnectKit panel — the DevProvider never engages.
NEXT_PUBLIC_APP_MODE=host

# Not used in dev mode (no product account), but uncomment to force a specific
# DotNS identifier. Normally derived at runtime from window.location.
# NEXT_PUBLIC_DOT_NS_IDENTIFIER=spacegame.dot

# SessionRegistry — session keys resolve to their owner through this contract.
# Filled in by the paseo-next-v2 deploy (Task 9).
NEXT_PUBLIC_SESSION_REGISTRY_ADDRESS=0xed11fec1cb5ecf3f2a0c0f8ca813440b23c9efab

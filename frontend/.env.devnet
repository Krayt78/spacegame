# Local dev server (next dev), but pointed at the REAL Summit Asset Hub — not a
# local node. Use this to run a SECOND player on your machine: the DevProvider
# signs as Alice/Bob/… (a per-tab pick), so you can play a match against your
# dot.li product account, which lives on the same chain.
#
#   npm run dev:net      # → http://localhost:3000, DevProvider
#
# Alice (//Alice) must be funded + revive-mapped on the Summit Asset Hub for
# writes to land. Other dev accounts (Bob, …) need faucet funding first.

NEXT_PUBLIC_CHAIN=testnet

# Deployer mnemonic (sr25519). This file is TRACKED — leave it empty here and
# never commit a real phrase. Empty = the contract deploy falls back to //Alice.
MNEMONIC=

# DevProvider — sign locally as Alice/Bob/…, no Polkadot Host involved. Skips
# the "Open in Polkadot Host" gate.
NEXT_PUBLIC_SIGNER_PROVIDER=dev

# Reads (ReviveApi.call) AND writes (Revive.call) target the Summit Asset Hub —
# the chain the contracts + your dot.li product account live on.
NEXT_PUBLIC_HUB_WS_URL=wss://summit-asset-hub-rpc.polkadot.io

# Contract addresses — fill in from contracts/deployments/summit.json after
# running the deployer (node scripts/deploy-contracts-nextv2.mjs deploy).
NEXT_PUBLIC_NEXUS_GAME_ADDRESS=
NEXT_PUBLIC_GAME_CONFIG_ADDRESS=

# Not used in dev mode (no product account), but uncomment to force a specific
# DotNS identifier. Normally derived at runtime from window.location.
# NEXT_PUBLIC_DOT_NS_IDENTIFIER=spacegame.dot

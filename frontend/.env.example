# =============================================================================
# Nexus Protocol - Frontend Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Chain Selection (REQUIRED)
# -----------------------------------------------------------------------------
# "testnet" for Polkadot Hub TestNet, "localhost" for local Hardhat node
NEXT_PUBLIC_CHAIN=localhost

# -----------------------------------------------------------------------------
# Contract Addresses (REQUIRED)
# -----------------------------------------------------------------------------
# These are populated after deploying contracts.
# Run `npm run deploy:local` or `npm run deploy:testnet` in contracts/
# and copy the addresses from deployments/latest.json.
NEXT_PUBLIC_NEXUS_GAME_ADDRESS=
NEXT_PUBLIC_GAME_CONFIG_ADDRESS=

# -----------------------------------------------------------------------------
# Network RPC URLs (Optional - defaults provided)
# -----------------------------------------------------------------------------
# Local Hardhat node (used when activeChain = localhost)
# Default: http://127.0.0.1:8545
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Polkadot Hub TestNet (used when activeChain = polkadotHubTestnet)
# Default: https://eth-rpc-testnet.polkadot.io
NEXT_PUBLIC_POLKADOT_HUB_RPC_URL=https://eth-rpc-testnet.polkadot.io

# Substrate WS endpoint for pallet-revive writes (must match the chain our
# contracts are deployed on — the @parity SDK's "paseo" preset is a DIFFERENT
# chain and is not what we want).
# Default: wss://asset-hub-paseo.dotters.network
NEXT_PUBLIC_HUB_WS_URL=wss://asset-hub-paseo.dotters.network

# -----------------------------------------------------------------------------
# Signer Provider (local dev only)
# -----------------------------------------------------------------------------
# "host" (default) — connect to the real Polkadot Host (dot.li / Spektr).
# "dev"            — use the DevProvider (Alice/Bob etc. from the well-known
#                    Substrate mnemonic). Skips the host login UI and signs
#                    writes locally. Useful for iterating without uploading
#                    to dot.li every time.
NEXT_PUBLIC_SIGNER_PROVIDER=host

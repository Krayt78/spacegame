# =============================================================================
# Nexus Protocol - Frontend Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Chain Selection (REQUIRED)
# -----------------------------------------------------------------------------
# "testnet" for AssetHub Westend, "localhost" for local Hardhat node
NEXT_PUBLIC_CHAIN=localhost

# -----------------------------------------------------------------------------
# Contract Addresses (REQUIRED)
# -----------------------------------------------------------------------------
# These are populated after deploying contracts.
# Run `npm run deploy:local` or `npm run deploy:testnet` in contracts/
# and copy the addresses from deployments/latest.json.
NEXT_PUBLIC_NEXUS_GAME_ADDRESS=
NEXT_PUBLIC_GAME_CONFIG_ADDRESS=

# -----------------------------------------------------------------------------
# Network RPC URLs (Optional - defaults provided)
# -----------------------------------------------------------------------------
# Local Hardhat node (used when activeChain = localhost)
# Default: http://127.0.0.1:8545
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# AssetHub Westend testnet (used when activeChain = assetHubWestend)
# Default: https://westend-asset-hub-eth-rpc.polkadot.io
NEXT_PUBLIC_ASSETHUB_RPC_URL=https://westend-asset-hub-eth-rpc.polkadot.io

# -----------------------------------------------------------------------------
# WalletConnect (Optional)
# -----------------------------------------------------------------------------
# Required for WalletConnect-based wallet connections (e.g. mobile wallets).
# Get a free project ID at https://cloud.walletconnect.com
# Leave empty to disable WalletConnect (MetaMask injection still works).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Production environment — AssetHub Westend testnet
# Real values should be set in Vercel dashboard environment variables.
# This file provides defaults for the production build.

NEXT_PUBLIC_CHAIN=testnet
NEXT_PUBLIC_ASSETHUB_RPC_URL=https://westend-asset-hub-eth-rpc.polkadot.io

# Contract addresses — update after testnet deployment
NEXT_PUBLIC_NEXUS_GAME_ADDRESS=
NEXT_PUBLIC_GAME_CONFIG_ADDRESS=

# WalletConnect — set in Vercel dashboard
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

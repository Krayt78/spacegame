# Production environment — Polkadot Hub TestNet
# Real values should be set in Vercel dashboard environment variables.
# This file provides defaults for the production build.

NEXT_PUBLIC_CHAIN=testnet
NEXT_PUBLIC_POLKADOT_HUB_RPC_URL=https://eth-rpc-testnet.polkadot.io
# Substrate WS for pallet-revive writes — must be the same chain the contracts live on.
NEXT_PUBLIC_HUB_WS_URL=wss://paseo-asset-hub-next-rpc.polkadot.io

# Contract addresses — update after testnet deployment
NEXT_PUBLIC_NEXUS_GAME_ADDRESS=0x64e619ea4d8a593c68533c0feaf3e36d3666495b
NEXT_PUBLIC_GAME_CONFIG_ADDRESS=0xa4fe17ea7595fc50e55319f46c54cf8c7b34b3e3

# DotNS identifier is derived at runtime from window.location since Phase 7
# (handles <label>.dot.li and <label>.app.dot.li). Uncomment only to force a
# specific identifier; a wrong value = "Permission denied" at sign time.
# NEXT_PUBLIC_DOT_NS_IDENTIFIER=nexusprotocol00.dot

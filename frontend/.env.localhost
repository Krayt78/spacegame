# Local Hardhat chain configuration
# Usage: npm run dev:local

NEXT_PUBLIC_CHAIN=testnet
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_POLKADOT_HUB_RPC_URL=https://eth-rpc-testnet.polkadot.io
# Substrate WS endpoint for pallet-revive writes (must match the chain our
# contracts are deployed on — the SDK's "paseo" preset points at a different chain).
NEXT_PUBLIC_HUB_WS_URL=wss://paseo-asset-hub-next-rpc.polkadot.io
NEXT_PUBLIC_NEXUS_GAME_ADDRESS=0x64e619ea4d8a593c68533c0feaf3e36d3666495b
NEXT_PUBLIC_GAME_CONFIG_ADDRESS=0xa4fe17ea7595fc50e55319f46c54cf8c7b34b3e3

# Sign-in provider for local development:
#   dev  = DevProvider (Alice/Bob/etc. from the well-known Substrate mnemonic;
#          no host container needed; skips the "Open in Polkadot Host" gate)
#   host = real Polkadot Host (requires running inside dot.li or another host shell)
NEXT_PUBLIC_SIGNER_PROVIDER=dev

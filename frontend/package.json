{
  "name": "nexus-protocol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "env-cmd -f .env.localhost sh -c 'node scripts/generate-cdm.mjs && node scripts/generate-contract-types.mjs && next dev'",
    "dev:testnet": "env-cmd -f .env.testnet sh -c 'node scripts/generate-cdm.mjs && node scripts/generate-contract-types.mjs && next dev'",
    "build": "next build",
    "build:static": "STATIC_EXPORT=1 next build",
    "prebuild:static": "node scripts/generate-cdm.mjs && node scripts/generate-contract-types.mjs",
    "gen:cdm": "node scripts/generate-cdm.mjs",
    "gen:types": "node scripts/generate-contract-types.mjs",
    "gen": "node scripts/generate-cdm.mjs && node scripts/generate-contract-types.mjs",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@novasamatech/host-papp": "0.6.18",
    "@novasamatech/product-sdk": "^0.6.12",
    "@novasamatech/statement-store": "0.6.18",
    "@parity/product-sdk-address": "0.1.1",
    "@parity/product-sdk-chain-client": "0.4.1",
    "@parity/product-sdk-contracts": "0.5.0",
    "@parity/product-sdk-descriptors": "0.4.0",
    "@parity/product-sdk-host": "0.3.0",
    "@parity/product-sdk-signer": "0.2.4",
    "@parity/product-sdk-tx": "0.2.3",
    "@polkadot-api/descriptors": "file:.papi/descriptors",
    "@polkadot-api/substrate-bindings": "^0.16.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-query": "^5.90.20",
    "clsx": "^2.1.1",
    "connectkit": "^1.9.1",
    "framer-motion": "^12.29.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.4",
    "polkadot-api": "^1.23.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "viem": "^2.45.0",
    "wagmi": "^3.4.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "env-cmd": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
